# 应用配置
APP_NAME=InduNexus API
APP_VERSION=1.0.0
DEBUG=True

# 服务器配置
HOST=0.0.0.0
PORT=8000

# PostgreSQL 数据库配置
# 💡 重要：请根据你的需求修改这些配置
# 如果你有多个项目共用 PostgreSQL，建议为每个项目使用不同的数据库名
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_username        # 修改为你的用户名
POSTGRES_PASSWORD=your_password    # 修改为你的密码
POSTGRES_DB=your_database_name     # 修改为你的数据库名（如：indunexus_db）

# Neo4j 图数据库配置（可选，未来使用）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# JWT 配置
# 💡 生产环境请使用: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS 配置
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
